# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase service account (never commit credentials)
src/lib/service-account.json
functions/gptbot/src/lib/service-account.json
functions/.env
functions/.env.*
functions/gptbot/.env
functions/gptbot/.env.*

# firebase functions compiled output & dependencies
functions/lib/
functions/node_modules/
functions/gptbot/lib/
functions/gptbot/node_modules/
